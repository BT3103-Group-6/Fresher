rules_version = '2';

// Default deny. Clients never write booking data (appointments, schedules, deposits,
// notifications, auditLog, waitlist, queue); callable functions do, via the Admin SDK.
// See docs/architecture.md "The key rule".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function claim(name) {
      return signedIn() && name in request.auth.token ? request.auth.token[name] : null;
    }
    function isAdmin() {
      return claim('admin') == true;
    }
    function isStaffOf(shopId) {
      return claim('shopId') == shopId && claim('role') in ['owner', 'barber'];
    }
    function isOwnerOf(shopId) {
      return claim('shopId') == shopId && claim('role') == 'owner';
    }
    // Costs one extra document read per rule evaluation (NFR-07); acceptable for the prototype.
    function shopIsVerified(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'verified';
    }
    // barberId comes from the barber's custom claim (set by addBarber), so no members lookup.
    function isBarberOf(shopId, barberId) {
      return claim('shopId') == shopId && claim('role') == 'barber' && claim('barberId') == barberId;
    }
    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /shops/{shopId} {
      allow read: if resource.data.status == 'verified' || isStaffOf(shopId) || isAdmin();
      // Shops are created by seed/functions only. Owners edit the profile but never status;
      // the platform admin may change only status (shop verification). priceMin, priceMax,
      // serviceTypes and minDurationMin are derived from services by a trigger (FR-01), so no client writes them.
      allow update: if (isOwnerOf(shopId)
          && !affected().hasAny(['status', 'tz', 'priceMin', 'priceMax', 'serviceTypes', 'minDurationMin']))
        || (isAdmin() && affected().hasOnly(['status']));

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isOwnerOf(shopId);
      }

      match /services/{serviceId} {
        allow read: if isStaffOf(shopId) || shopIsVerified(shopId);
        allow create, update: if isOwnerOf(shopId)
          && request.resource.data.keys().hasOnly(['name', 'category', 'durationMin', 'priceCents', 'active'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.category in ['haircut', 'beard', 'shave', 'colour', 'perm', 'kids', 'other']
          && request.resource.data.durationMin is int
          && request.resource.data.durationMin > 0 && request.resource.data.durationMin % 5 == 0
          && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
          && request.resource.data.active is bool;
        allow delete: if isOwnerOf(shopId);
      }

      match /barbers/{barberId} {
        allow read: if isStaffOf(shopId) || shopIsVerified(shopId);
        // Claims for a new barber are set by the addBarber function, so owners only edit existing ones.
        allow update: if isOwnerOf(shopId)
          && request.resource.data.keys().hasOnly(['displayName', 'active', 'serviceIds', 'workingHours'])
          && request.resource.data.displayName is string
          && request.resource.data.active is bool
          && request.resource.data.serviceIds is list
          && request.resource.data.workingHours is map;
      }

      // Busy intervals only, no customer data (architecture.md "Public reads").
      match /schedules/{scheduleId} {
        allow read: if isStaffOf(shopId) || shopIsVerified(shopId);
      }

      match /blocks/{blockId} {
        allow read: if isStaffOf(shopId);
      }
      match /dailyStats/{day} {
        allow read: if isStaffOf(shopId);
      }
      match /queue/{entryId} {
        allow read: if isStaffOf(shopId);
      }
    }

    match /appointments/{bookingId} {
      allow read: if (signedIn() && resource.data.customerId == request.auth.uid)
        || isOwnerOf(resource.data.shopId)
        || isBarberOf(resource.data.shopId, resource.data.barberId);
    }

    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      match /shopStats/{shopId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    match /auditLog/{eventId} {
      allow read: if isStaffOf(resource.data.shopId);
    }
    match /notifications/{taskId} {
      allow read: if isStaffOf(resource.data.shopId);
    }
    match /deposits/{depositId} {
      allow read: if isStaffOf(resource.data.shopId);
    }
    match /waitlist/{entryId} {
      allow read: if (signedIn() && resource.data.customerId == request.auth.uid)
        || isStaffOf(resource.data.shopId);
    }
  }
}
