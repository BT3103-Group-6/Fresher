# Copy to .env.local. In dev the app talks to the Firebase emulators, so these can stay as placeholders.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=fresher-6d857.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fresher-6d857
VITE_FIREBASE_APP_ID=demo-app-id
# Production builds only (npm run build): the App Check site key (reCAPTCHA Enterprise key id). Required by the build.
VITE_APP_CHECK_SITE_KEY=
# Demo mode label and mock checkout buttons. Off by default; the public demo sets it in .env.production. See docs/deployment.md.
VITE_DEMO_MODE=false
