# Copy to .env.local. In dev the app talks to the Firebase emulators, so these can stay as placeholders.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=fresher-6d857.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fresher-6d857
VITE_FIREBASE_APP_ID=demo-app-id
# Production builds only (npm run build): the App Check site key (reCAPTCHA Enterprise key id). Required by the build unless VITE_APP_CHECK_ENABLED=false.
VITE_APP_CHECK_SITE_KEY=
# App Check in the web app. On by default; set false (with APP_CHECK_ENFORCE=false in functions/.env.prod) to run without it.
VITE_APP_CHECK_ENABLED=true
# Demo mode label and mock checkout buttons. Off by default; the public demo sets it in .env.production. See docs/deployment.md.
VITE_DEMO_MODE=false
# Landing page map (Google Maps JavaScript API). A browser key restricted to your HTTP referrers and the Maps JavaScript API; public by design. Without it the map shows the list view only.
VITE_GOOGLE_MAPS_API_KEY=
# The Map ID whose cloud-based style hides points of interest and mutes parks and water (steps in docs/deployment.md). Without it, Google's DEMO_MAP_ID is used and the map has Google's default, busier look.
VITE_GOOGLE_MAP_ID=
